---
interface Props {
    src: string;
    text: string;
}
const {src, text } = Astro.props;
---

<a
    class="bg-transparent text-base text-white py-[0.3rem] px-[0.8rem] rounded-lg border-2 border-white transition duration-200 ease-out hover:text-black hover:bg-white mg:text-[1.05rem] mg:py-[0.4rem] mg:px-[1.1rem] mg:semi-bold"
    role="button"
    href={src}>{text}</a
>