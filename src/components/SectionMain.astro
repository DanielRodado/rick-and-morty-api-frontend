---
interface Props {
    subtitle?: string;
}

const { subtitle } = Astro.props;
---

<section class="my-8 px-5 text-center">
    <h1 class="text-secondary font-black text-3xl sm:text-4xl md:text-5xl lg:text-7xl">The Rick and Morty</h1>
    {
        subtitle !== undefined
            ? <h3 class="text-secondary font-black text-xl border-t-2 border-dashed border-[#ccc] mt-3 p-1 text-balance sm:text-2xl md:text-3xl md:mt-5 md:p-2 lg:text-[2.6rem] lg:mt-6 lg:p-3 2xl:mx-auto">
                    {subtitle}
              </h3>
            : ""
    }
</section>
