---
interface Props {
    src: string;
    title: string;
}

const { src, title } = Astro.props;
const path = Astro.url.pathname;
---

<li class:list={[
    "text-secondary text-base font-bold transition ease-in-out duration-300 hover:text-warning sm:text-lg mg:text-xl",
    {
        "text-warning": path.includes(title.toLowerCase())
    }
]}>
    <a href={src}>{title}</a>
</li>
